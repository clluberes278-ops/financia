# Web build context: allow only the files consumed by Dockerfile.web.
**
!Dockerfile.web
!package.json
!package-lock.json
!index.web.js
!babel.config.js
!webpack.config.js
!tsconfig.json
!apps/
!apps/mobile/
!apps/mobile/package.json
!apps/mobile/App.tsx
!apps/mobile/app.json
!apps/mobile/index.js
!apps/mobile/babel.config.js
!apps/mobile/tsconfig.json
!apps/mobile/components/
!apps/mobile/components/**
!apps/mobile/screens/
!apps/mobile/screens/**
!apps/mobile/store/
!apps/mobile/store/**
!apps/mobile/types/
!apps/mobile/types/**
!apps/mobile/utils/
!apps/mobile/utils/**
!web/
!web/**
!packages/
!packages/api-client/
!packages/api-client/**
!scripts/
!scripts/public-config-plugin.cjs
!scripts/validate-public-key.cjs
!docker/
!docker/nginx.conf

# Never send secrets or generated dependencies, even inside allowed directories.
**/.env
**/.env.*
**/secrets.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/node_modules
**/bin
**/obj
**/.git
**/artifacts
**/*.db
**/*.db-shm
**/*.db-wal
