# Web build context: allow only the files consumed by Dockerfile.web.
**
!Dockerfile.web
!package.json
!package-lock.json
!App.tsx
!app.json
!index.web.js
!babel.config.js
!webpack.config.js
!tsconfig.json
!components/
!components/**
!screens/
!screens/**
!store/
!store/**
!types/
!types/**
!utils/
!utils/**
!web/
!web/**
!packages/
!packages/api-client/
!packages/api-client/**
!scripts/
!scripts/public-config-plugin.cjs
!scripts/validate-public-key.cjs
!docker/
!docker/nginx.conf

# Never send secrets or generated dependencies, even inside allowed directories.
**/.env
**/.env.*
**/secrets.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/node_modules
**/bin
**/obj
**/.git
**/artifacts
**/*.db
**/*.db-shm
**/*.db-wal
