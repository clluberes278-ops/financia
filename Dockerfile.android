# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless curl unzip git \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_HOME=/opt/android-sdk \
    CMAKE_BUILD_PARALLEL_LEVEL=2
ENV PATH=${JAVA_HOME}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}
# Official Google package and checksum, pinned to the downloaded tools revision.
RUN curl --fail --location --retry 3 https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip -o /tmp/android-tools.zip \
    && echo '4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583  /tmp/android-tools.zip' | sha256sum --check - \
    && mkdir -p ${ANDROID_HOME}/cmdline-tools \
    && unzip -q /tmp/android-tools.zip -d ${ANDROID_HOME}/cmdline-tools \
    && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
    && rm /tmp/android-tools.zip
RUN yes | sdkmanager --licenses >/dev/null \
    && sdkmanager 'platform-tools' 'platforms;android-36' 'build-tools;36.0.0' 'ndk;27.1.12297006' 'cmake;3.22.1'
WORKDIR /workspace
COPY package.json package-lock.json ./
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN npm ci --no-audit --no-fund
COPY apps/mobile/ ./apps/mobile/
COPY packages/api-client/ ./packages/api-client/
COPY scripts/public-config-plugin.cjs scripts/validate-public-key.cjs ./scripts/
ARG FINANCIA_SUPABASE_URL
ARG FINANCIA_API_URL
ARG PUBLIC_CONFIG_DIGEST
ARG ANDROID_ARCHITECTURES=arm64-v8a
ENV FINANCIA_SUPABASE_URL=${FINANCIA_SUPABASE_URL} FINANCIA_API_URL=${FINANCIA_API_URL}
WORKDIR /workspace/apps/mobile/android
RUN --mount=type=secret,id=supabase_public_key,env=FINANCIA_SUPABASE_ANON_KEY,required=true \
    --mount=type=cache,target=/root/.gradle \
    test -n "$PUBLIC_CONFIG_DIGEST" \
    && sh ./gradlew assemblePreview --no-daemon --max-workers=2 -PreactNativeArchitectures=${ANDROID_ARCHITECTURES} \
    && mkdir -p /output \
    && cp app/build/outputs/apk/preview/app-preview.apk /output/financia-preview.apk \
    && ${ANDROID_HOME}/build-tools/36.0.0/apksigner verify /output/financia-preview.apk \
    && unzip -l /output/financia-preview.apk | grep 'assets/index.android.bundle' \
    && cd /output && sha256sum financia-preview.apk > financia-preview.apk.sha256
FROM scratch AS artifact
COPY --from=build /output/ /
