{
  "name": "financia",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @financia/mobile --",
    "android": "npm run android --workspace @financia/mobile --",
    "ios": "npm run ios --workspace @financia/mobile --",
    "web": "webpack serve --mode development",
    "build:web": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "api:start": "node scripts/run-api.cjs run",
    "api:test": "node scripts/run-api.cjs test",
    "api:test:postgres": "node scripts/test-postgres.cjs",
    "api:build": "node scripts/run-api.cjs build",
    "api:connected": "node scripts/run-connected.cjs api",
    "web:connected": "node scripts/run-connected.cjs web",
    "android:connected": "node scripts/run-connected.cjs android",
    "docker:up": "node scripts/run-docker.cjs up",
    "docker:stop": "node scripts/run-docker.cjs stop",
    "docker:logs": "node scripts/run-docker.cjs logs",
    "docker:status": "node scripts/run-docker.cjs status",
    "docker:check": "node scripts/run-docker.cjs config",
    "docker:lint": "node scripts/run-docker.cjs lint",
    "docker:verify": "node scripts/run-docker.cjs verify",
    "api:generate": "node scripts/refresh-api-client.cjs",
    "api:check": "node scripts/refresh-api-client.cjs --check",
    "typecheck:client": "tsc --noEmit --project packages/api-client/tsconfig.json",
    "mobile:config": "npm run config --workspace @financia/mobile --",
    "mobile:bundle:android": "npm run bundle:android --workspace @financia/mobile --",
    "mobile:apk:debug": "node scripts/build-android.cjs debug",
    "mobile:apk:preview": "node scripts/build-android.cjs preview",
    "mobile:apk:docker": "node scripts/build-android-docker.cjs",
    "mobile:apk:release": "node scripts/build-android.cjs release",
    "mobile:aab:release": "node scripts/build-android.cjs bundle"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.4",
    "babel-loader": "^10.0.0",
    "dotenv": "^17.0.0",
    "html-webpack-plugin": "^5.0.0",
    "typescript": "~6.0.3",
    "webpack": "^5.0.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.0.0"
  },
  "private": true
}
