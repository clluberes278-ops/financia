# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN npm ci --no-audit --no-fund

COPY index.web.js babel.config.js webpack.config.js tsconfig.json ./
COPY apps/mobile/App.tsx apps/mobile/app.json apps/mobile/index.js apps/mobile/babel.config.js apps/mobile/tsconfig.json ./apps/mobile/
COPY apps/mobile/components ./apps/mobile/components
COPY apps/mobile/screens ./apps/mobile/screens
COPY apps/mobile/store ./apps/mobile/store
COPY apps/mobile/types ./apps/mobile/types
COPY apps/mobile/utils ./apps/mobile/utils
COPY web ./web
COPY packages/api-client ./packages/api-client
COPY scripts/public-config-plugin.cjs scripts/validate-public-key.cjs ./scripts/

# These values are public browser configuration, never server credentials.
ARG FINANCIA_SUPABASE_URL
ARG FINANCIA_API_URL=http://127.0.0.1:5081
ARG PUBLIC_CONFIG_DIGEST
ENV FINANCIA_SUPABASE_URL=${FINANCIA_SUPABASE_URL} \
    FINANCIA_API_URL=${FINANCIA_API_URL}
# The mount is temporary. Its public value still intentionally appears in the JS bundle.
# Its digest invalidates this layer when that public configuration changes.
RUN --mount=type=secret,id=supabase_public_key,env=FINANCIA_SUPABASE_ANON_KEY,required=true \
    test -n "$PUBLIC_CONFIG_DIGEST" && npm run build:web

FROM nginx:stable-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1
# Skip the image's root-oriented configuration scripts; nginx.conf is complete.
ENTRYPOINT []
CMD ["nginx", "-g", "daemon off;"]
