  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ClosePocketRequest": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "string",
            "pattern": "^[0-9]\u002B$"
          }
        },
        "required": [
          "expectedVersion"
        ],
        "additionalProperties": false
      },
      "CreateMovementRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "DOP",
              "USD"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]\u002B(?:\\.[0-9]{1,2})?$",
            "description": "Decimal amount, at most two fractional digits; maximum 999999999999.99. Zero is allowed only for currentAmount."
          },
          "type": {
            "type": "string",
            "enum": [
              "ingreso",
              "gasto"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "comida",
              "transporte",
              "entretenimiento",
              "servicios",
              "salud",
              "educacion",
              "salario",
              "otros"
            ]
          },
          "date": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "currency",
          "amount",
          "type",
          "category",
          "date"
        ],
        "additionalProperties": false
      },
      "CreateMovementResponse": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[0-9]\u002B$"
          },
          "movement": {
            "$ref": "#/components/schemas/V2Movement"
          }
        },
        "required": [
          "revision",
          "movement"
        ]
      },
      "CreatePocketRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "DOP",
              "USD"
            ]
          },
          "targetAmount": {
            "type": "string",
            "pattern": "^[0-9]\u002B(?:\\.[0-9]{1,2})?$",
            "description": "Decimal amount, at most two fractional digits; maximum 999999999999.99. Zero is allowed only for currentAmount."
          },
          "emoji": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "name",
          "currency",
          "targetAmount"
        ],
        "additionalProperties": false
      },
      "DeleteMovementResponse": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "pattern": "^[0-9]\u002B$"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]\u002B$"
          },
          "deleted": {
            "type": "boolean",
            "default": true,
            "const": true
          }
        },
        "required": [
          "revision",
          "id",
          "version",
          "deleted"
        ]
      },
      "EditPocketRequest": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "string",
            "pattern": "^[0-9]\u002B$"
          },
          "name": {
            "type": "string"
          },
