{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "react",
      "node"
    ],
    "moduleSuffixes": [
      ".native",
      ""
    ],
    "skipLibCheck": true
  },
  "include": [
    "App.tsx",
    "components/**/*.tsx",
    "screens/**/*.tsx",
    "store/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "app",
    "supabase",
    "artifacts",
    "backend"
  ]
}
